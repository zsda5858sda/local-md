{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local MD",
  "version": "1.1.1-a",
  "identifier": "app.localmd.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local MD",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "dragDropEnabled": false
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Local-first Markdown editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
